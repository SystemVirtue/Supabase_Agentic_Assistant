FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy pyproject.toml files
COPY pyproject.toml .
COPY world_state_service/pyproject.toml ./world_state_service/

# Install Python dependencies
RUN pip install --no-cache-dir -e ".[dev]"
RUN pip install --no-cache-dir -e "./world_state_service[dev]"

# Copy application code
COPY gateway ./gateway
COPY shared ./shared
COPY world_state_service ./world_state_service

# Generate protobuf bindings
RUN if [ -f shared/scripts/generate_protos.sh ]; then \
    bash shared/scripts/generate_protos.sh; \
    fi

# Set environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Run the application
CMD ["python", "-m", "world_state_service.app.main"]
