NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=dca_events
NATS_STREAM_SUBJECTS=perception.v1.>,cognition.v1.>
NATS_CONSUMER_GROUP=wss_workers
SERVICE_NAME=gateway
EVENT_SCHEMA_VERSION=1.0.0

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
REDIS_URL=redis://localhost:6379

# World State Service Configuration
BELIEF_DECAY_LAMBDA=0.1
FACT_PROMOTION_THRESHOLD=0.9
FACT_PROMOTION_DURATION_HOURS=24
CONFLICT_DETECTION_THRESHOLD=0.7

# Cognitive Engine Configuration
LITELM_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_MODEL=ollama/llama3.2
SIMPLE_MODEL=ollama/llama3.2
MODERATE_MODEL=anthropic/claude-3-5-sonnet
COMPLEX_MODEL=anthropic/claude-3-5-sonnet
VISION_MODEL=anthropic/claude-3-5-sonnet
MAX_COST_USD=1.0
MAX_LATENCY_MS=30000
MAX_INPUT_TOKENS=100000
SIMPLE_TOKEN_THRESHOLD=100
MODERATE_TOKEN_THRESHOLD=1000
COMPLEX_TOKEN_THRESHOLD=10000
LANGGRAPH_STATE_TTL=86400

# Edge Daemon Configuration
GATEWAY_URL=http://localhost:8000
SENSOR_ID=edge-daemon-001
SENSOR_TYPE=camera
SENSOR_LOCATION=living_room
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
YOLO_IOU_THRESHOLD=0.45
WHISPER_MODEL=base
WHISPER_SAMPLE_RATE=16000
AUDIO_ENABLED=false
AUDIO_CHUNK_DURATION=5
PROCESSING_INTERVAL=1.0

# Agent Lifecycle Manager Configuration
AGENT_HEARTBEAT_INTERVAL=30
AGENT_TIMEOUT=120
TASK_ALLOCATION_INTERVAL=10
TRUST_DECAY_RATE=0.01
TRUST_BOOST_ON_SUCCESS=0.1
TRUST_PENALTY_ON_FAILURE=0.2

